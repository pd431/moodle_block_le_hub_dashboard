{{!
    @template block_le_hub_dashboard/catpicker

    A category picker (C1): the site's categories as a tree of checkboxes, for the administrator's "categories the
    hub works in" setting. The checkboxes post as field[] so an unticked tree saves as empty (every category).

    Example context (json):
    {
        "id": "id_s_block_le_hub_dashboard_categories",
        "field": "s_block_le_hub_dashboard_categories",
        "categories": [
            {"id": 2, "name": "Faculty of Science", "depth": 1, "parent": 0, "checked": true},
            {"id": 3, "name": "Biosciences", "depth": 2, "parent": 2, "checked": false}
        ],
        "hascategories": true
    }
}}
<div class="hub-catpicker block_le_hub_dashboard" id="{{id}}" data-region="hub-catpicker">
    <input type="hidden" name="{{field}}" value="">
    <div class="hub-tree" role="group" aria-labelledby="{{id}}label">
        {{#categories}}
        <label class="hub-tree-item hub-tree-item--depth{{depth}}" data-region="hub-tree-item" data-id="{{id}}" data-parent="{{parent}}">
            <input type="checkbox" name="{{field}}[]" value="{{id}}" data-action="pick-category"{{#checked}} checked{{/checked}}> <span class="hub-tree-name">{{name}}</span>
        </label>
        {{/categories}}
    </div>
    {{^hascategories}}<p class="text-muted">{{#str}}catpicker_none, block_le_hub_dashboard{{/str}}</p>{{/hascategories}}
</div>
