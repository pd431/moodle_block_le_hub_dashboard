{{!
    @template block_le_hub_dashboard/rowitem

    One hub row as a list item: what a group lists, and what one batch fetch returns (L2). It carries its group
    and sort key, so the page's script can put a fetched row in the right group, in order.

    Example context (json):
    {
        "id": "hub-12", "cmid": 12, "group": "chase", "sortkey": 1700000000, "assesstype": "summative",
        "reasonkeys": "late", "flagkeys": "unallocated", "search": "problem sheet 4 mth2003 assignment",
        "courseid": 3, "name": "Problem sheet 4", "url": "#", "course": "MTH2003", "courseurl": "#", "coursename": "Linear Algebra",
        "modicon": null, "tip": "Assignment", "reasons": [], "status": "", "progress": null, "flags": [], "dates": [], "setup": [],
        "bars": [], "people": {"convenors": [], "markers": [], "outstanding": null, "reallocateurl": null}, "notes": [], "hasnotes": false,
        "ignore": null
    }
}}
<li class="hub-row" id="{{id}}" data-region="hub-row" data-cmid="{{cmid}}" data-group="{{group}}" data-sortkey="{{sortkey}}"
    data-assesstype="{{assesstype}}" data-reasons="{{reasonkeys}}" data-flags="{{flagkeys}}" data-search="{{search}}">
    {{> block_le_hub_dashboard/row }}
</li>
